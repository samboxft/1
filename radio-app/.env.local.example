# Database
DATABASE_URL="file:./dev.db"

# Google Gemini AI (required for AI host intros)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs TTS (preferred — high-quality voices)
# Get your key at: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Google Cloud TTS (fallback if ElevenLabs is not configured)
# Enable at: https://console.cloud.google.com/apis/library/texttospeech.googleapis.com
GOOGLE_TTS_API_KEY=your_google_tts_api_key_here

# NewsAPI (optional — used for hourly news headlines)
# Get your free key at: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here
